APP_ENVIRONMENT=development

# Database (src/database.py)
DATABASE_URL=postgresql+asyncpg://business_os:business_os@localhost:5432/business_os

# Storage provider (src/shared/storage) — s3 | gcs | r2 | minio
STORAGE_PROVIDER=minio
S3_BUCKET=uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# Upload domain (src/upload/config.py)
MAX_SMALL_FILE_SIZE=2097152
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4

# Cache (src/shared/cache)
REDIS_URL=redis://localhost:6379/0

# Deduplication domain (src/dedup/config.py)
DEDUP_ENABLED=true
DEDUP_CACHE_TTL=86400
DEDUP_LOCK_TTL=10
DEDUP_LOCK_RETRY_MAX=3
DEDUP_LOCK_RETRY_DELAY_MS=50
DEDUP_DB_QUERY_TIMEOUT=5
